<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pixelduke.samples.transit.sampler.SamplerBaseController">
<VBox>
    <Label layoutX="43.0" layoutY="20.0" styleClass="header" text="Toolbar" />

   <BorderPane prefHeight="38.0" prefWidth="710.0">
      <right>
         <Button fx:id="changeThemeButton" focusTraversable="false" mnemonicParsing="false" onAction="#onStyleChange" BorderPane.alignment="CENTER">
            <graphic>
               <ImageView pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@icons8-moon-symbol-16.png" />
                  </image>
               </ImageView>
            </graphic></Button>
      </right>
   </BorderPane>
      <Label styleClass="header4" text="Normal" wrapText="true" />
      <BorderPane prefWidth="200.0" styleClass="control-container">
         <left>
            <VBox styleClass="inner-container">
               <children>
                  <ToolBar focusTraversable="false" minHeight="-Infinity" prefHeight="40.0">
                     <items>
                        <Button mnemonicParsing="false" text="Save">
                           <graphic>
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@icons8-save-16.png" />
                                 </image>
                              </ImageView>
                           </graphic></Button>
                        <HBox alignment="CENTER_LEFT">
                           <ToggleButton mnemonicParsing="false" selected="true" styleClass="left-pill" text="Left Pill">
                              <toggleGroup>
                                 <ToggleGroup fx:id="toggleGroup" />
                              </toggleGroup></ToggleButton>
                           <ToggleButton mnemonicParsing="false" styleClass="right-pill" text="Right Pill" toggleGroup="$toggleGroup" />
                        </HBox>
                        <ToggleButton mnemonicParsing="false" text="Visible">
                           <graphic>
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@icons8-visible-16.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </ToggleButton>
                        <Separator orientation="VERTICAL" prefHeight="200.0" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                           <children>
                              <Label maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="Label:" />
                              <TextField />
                           </children>
                        </HBox>
                     </items></ToolBar>
               </children>
            </VBox>
         </left>
         <VBox.margin>
            <Insets bottom="40.0" />
         </VBox.margin>
      </BorderPane>
   <Label styleClass="header4" text="Styleclass 'light' Applied" wrapText="true" />
   <Label styleClass="body-text" text="The following styles are when the 'light' styleclass is added to the control. This can be useful when you want to have it look less prominent." wrapText="true">
      <VBox.margin>
         <Insets bottom="15.0" />
      </VBox.margin>
   </Label>
   <BorderPane prefWidth="200.0" styleClass="control-container">
      <left>
         <VBox styleClass="inner-container">
            <children>
               <ToolBar minHeight="-Infinity" prefHeight="40.0" styleClass="light">
                  <items>
                        <Button focusTraversable="false" mnemonicParsing="false" text="Save">
                           <graphic>
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@icons8-save-16.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </Button>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <ToggleButton focusTraversable="false" mnemonicParsing="false" selected="true" styleClass="left-pill" text="Left Pill">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="toggleGroup2" />
                                 </toggleGroup>
                              </ToggleButton>
                              <ToggleButton focusTraversable="false" mnemonicParsing="false" styleClass="right-pill" text="Right Pill" toggleGroup="$toggleGroup2" />
                           </children>
                        </HBox>
                        <ToggleButton focusTraversable="false" mnemonicParsing="false" text="Visible">
                           <graphic>
                              <ImageView pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@icons8-visible-16.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </ToggleButton>
                     <Separator orientation="VERTICAL" prefHeight="200.0" />
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Label maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="Label:" />
                           <TextField />
                        </children>
                     </HBox>
                  </items>
               </ToolBar>
            </children>
         </VBox>
      </left>
      <VBox.margin>
         <Insets bottom="40.0" />
      </VBox.margin>
      </BorderPane>

   <padding>
      <Insets bottom="60.0" right="60.0" />
   </padding>
</VBox>
</ScrollPane>
